# --- LLM backend switch ---
LLM_BACKEND=cloud                 # "cloud" or "local"

# --- Cloud backend (used when LLM_BACKEND=cloud) ---
ANTHROPIC_API_KEY=
CLOUD_MODEL_FAST=claude-haiku-4-5      # keyword gen, per-paper extraction (high volume)
CLOUD_MODEL_STRONG=claude-sonnet-4-5   # comparison synthesis, gap analysis, verifier

# --- Local backend (used when LLM_BACKEND=local, requires Ollama running) ---
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL_FAST=qwen3:8b
LOCAL_MODEL_STRONG=qwen3:14b
# Max seconds allowed between successive streamed chunks (not total generation time) — raise
# this only if you still see timeouts on very slow hardware after the streaming fix.
OLLAMA_READ_TIMEOUT=120
# Reasoning models (Qwen3 etc.) spend most of their time on an internal thinking trace that
# these tasks don't need — off by default for speed. Set true to re-enable (slower, may help
# "strong" tier reasoning quality on faster hardware).
OLLAMA_THINK=false
# Thinking for chosen steps only (comma list), e.g. propose-gaps,synthesize-trends - see README "Thinking mode"
OLLAMA_THINK_PURPOSES=
# Context window size (tokens) llm_client requests from Ollama, capped to this ceiling — see
# config.py / llm_client._call_ollama. Raise only if you have RAM to spare; higher = slower.
OLLAMA_MAX_CTX=8192

# --- Sampling: temperature 0 + fixed seed = same question gives the same substance (harness tuning) ---
LLM_TEMPERATURE=0
LLM_SEED=42

# --- Tool-calling agents (search agent in Node 2, verifier agent in Node 7) ---
MAX_TOOL_STEPS=8
MAX_SEARCH_TOOL_CALLS=10
VERIFIER_TEXT_CHARS=3000

# --- Privacy: LLM entity extraction on each PDF's header (regex + author-list + affiliation-line redaction always runs) ---
# always = every full-text paper (~7-12 s each locally); auto = only when the deterministic detectors
# can't vouch for the header - faster but measured to leak names (see config.py); never
PRIVACY_LLM_ON_PAPERS=always
PRIVACY_HEADER_CHARS=2500

# --- Full-text PDF extraction (Node 5 — see sources/pdf_extract.py) ---
# Downloads each selected paper's open-access PDF and converts it to Markdown for extraction,
# instead of using only the abstract. Roughly doubles Node 5's time per paper (download + PDF
# parse on top of the LLM call) — set to false for the faster, original abstract-only behavior.
FETCH_FULL_TEXT=true
PDF_CACHE_DIR=pdf_cache
PDF_MAX_PAGES=40
PDF_MAX_DOWNLOAD_MB=25

# --- Data source API keys (free; without them the search may fall back to arXiv alone) ---
# Semantic Scholar: without a key every request shares one public pool and is often refused (429).
#   Free key (1 request/s of your own): https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex: an API key is required since Feb 2026 (free): https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=                   # optional; ignored by OpenAlex since API keys replaced the polite pool
# Retries on 429/5xx (Retry-After honoured) and switch a source off after this many failed calls
SOURCE_MAX_RETRIES=3
SOURCE_RETRY_MAX_WAIT=10
SOURCE_DISABLE_AFTER_FAILURES=3
UNPAYWALL_EMAIL=you@example.com    # Unpaywall requires an email identifier, not a key

# --- Data source (MVP: one source; comma-separated to widen, e.g. openalex,semantic_scholar,arxiv) ---
ENABLED_SOURCES=openalex           # openalex needs OPENALEX_API_KEY above (free)

# --- Run defaults (overridable via CLI flags, see main.py --help) ---
# MVP scope: ~20-30 candidates -> 8-12 analysed papers (enough for a demo, not a systematic review)
MAX_CANDIDATE_PAPERS=30
MIN_CANDIDATE_PAPERS=20            # fewer candidates than this = "too few" -> broader queries
MAX_DEEP_ANALYSIS_PAPERS=10        # ~45 s per paper on a local 14B model
MVP_MIN_PAPERS=8                   # web UI slider range
MVP_MAX_PAPERS=12
# Evidence level of a gap (README "Evidence levels"): "Strong" needs at least this many analysed
# papers and paper sources that answered (the old "High" ceiling - names kept for existing .env files)
HIGH_CONFIDENCE_MIN_PAPERS=8
HIGH_CONFIDENCE_MIN_SOURCES=1    # 1 for the single-source MVP; 2 when several sources are enabled
# ...and, per gap, these countable thresholds (defaults shown)
EVIDENCE_STRONG_MIN_SUPPORTING=3
EVIDENCE_STRONG_MIN_FULL_TEXT=2
EVIDENCE_STRONG_MIN_COVERAGE=1.0
EVIDENCE_STRONG_MAX_AGE_YEARS=3
EVIDENCE_MODERATE_MIN_SUPPORTING=2
EVIDENCE_MODERATE_MIN_COVERAGE=0.5
MIN_PAPERS_BEFORE_RETRY=8
MAX_RETRY_LOOPS=3
# "Too broad": candidate pool full but < this share passed the relevance cut-off -> more specific queries
BROAD_MAX_PASS_RATE=0.4
MAX_NARROW_LOOPS=1
# Budget per run. When used up: no more retry/narrow loops, and the remaining gaps are not
# verified (kept, evidence Limited). 0 = no limit. See README "Decision rules and stop conditions".
MAX_RUN_TOKENS=250000              # input + output tokens
MAX_RUN_SECONDS=1800               # wall clock

# --- Citation check before the report (Crossref + OpenAlex; false = skip lookups) ---
VERIFY_CITATIONS=true
CITATION_TITLE_SIM=0.9

# --- Relevance ranking (Node 3) ---
# Embedding used to rank candidates; empty = same as RAG_EMBEDDING. The cut-off is per model
# (embeddings.RANKING_THRESHOLDS, from evaluation/calibrate_ranking.py); set SIMILARITY_THRESHOLD to override.
RANKING_EMBEDDING=
SIMILARITY_THRESHOLD=

# --- RAG knowledge base (persists across runs in rag_store/, never commit it) ---
RAG_ENABLED=true
RAG_STORE_DIR=rag_store
# sentence_transformers:<huggingface id>  or  ollama:<model>
# Measured on this project (evaluation/compare_embeddings.py, 13 real papers, EN+TH questions):
#   ollama:embeddinggemma:300m  hit@3 EN 0.88 / TH 0.76   <- best, needs `ollama pull embeddinggemma:300m`
#   sentence_transformers:BAAI/bge-small-en-v1.5  0.65 / 0.39 (no Ollama needed)
RAG_EMBEDDING=sentence_transformers:BAAI/bge-small-en-v1.5
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_REUSE_EXTRACTS=true

# --- Langfuse tracing (optional; off unless both keys are set) ---
# Self-hosted: LANGFUSE_BASE_URL=http://localhost:3000   Cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
TRACING_ENABLED=true
